local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

-- Paste user ids below, one per line (commas or spaces also work).
-- Don't put any other numbers in this block.
local WHITELIST_RAW = [[
987654321
111111111
]]

local whitelist = {}
for id in WHITELIST_RAW:gmatch("%d+") do
    whitelist[tonumber(id)] = true
end

if not whitelist[LocalPlayer.UserId] then
    -- Black screen
    pcall(function()
        local gui = Instance.new("ScreenGui")
        gui.IgnoreGuiInset = true
        gui.DisplayOrder = 2147483647
        gui.ResetOnSpawn = false

        local frame = Instance.new("Frame")
        frame.Size = UDim2.new(1, 0, 1, 0)
        frame.BackgroundColor3 = Color3.new(0, 0, 0)
        frame.BorderSizePixel = 0
        frame.Parent = gui

        gui.Parent = (gethui and gethui()) or game:GetService("CoreGui")
    end)

    -- Kill now and on every respawn
    local function kill()
        pcall(function()
            local hum = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
            if hum then hum.Health = 0 end
        end)
    end
    kill()
    LocalPlayer.CharacterAdded:Connect(function()
        task.wait()
        kill()
    end)

    -- Kick
    pcall(function()
        LocalPlayer:Kick("Not whitelisted.")
    end)

    -- Fallback: if the kick gets blocked, keep killing and never reach the rest of the script
    while true do
        kill()
        task.wait()
    end
end

