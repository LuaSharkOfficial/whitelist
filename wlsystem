local whitelistedUserIds = {
    4761613231, -- Replace with actual User IDs
    87654321,
}

local function isWhitelisted(userId)
    for _, id in ipairs(whitelistedUserIds) do
        if id == userId then
            return true
        end
    end
    return false
end

game.Players.PlayerAdded:Connect(function(player)
    if not isWhitelisted(player.UserId) then
        -- 1. Apply full-screen black frame
        local playerGui = player:WaitForChild("PlayerGui")
        local screenGui = Instance.new("ScreenGui")
        screenGui.Name = "AccessDeniedGui"
        screenGui.IgnoreGuiInset = true
        screenGui.ResetOnSpawn = false

        local frame = Instance.new("Frame")
        frame.Size = UDim2.new(1, 0, 1, 0)
        frame.BackgroundColor3 = Color3.new(0, 0, 0)
        frame.BorderSizePixel = 0
        frame.Parent = screenGui

        screenGui.Parent = playerGui

        -- 2. Loop kill & continuous kick loop (bypasses anti-kick)
        task.spawn(function()
            while player and player.Parent do
                -- Loop kill character
                local character = player.Character
                if character then
                    local humanoid = character:FindFirstChildOfClass("Humanoid")
                    if humanoid and humanoid.Health > 0 then
                        humanoid.Health = 0
                    end
                end

                -- Repeatedly attempt kick
                pcall(function()
                    player:Kick("You are not whitelisted.")
                end)

                task.wait(0.5)
            end
        end)
        return
    end

    -- Put your main script code here for whitelisted players
    print(player.Name .. " passed the whitelist check.")
end)
